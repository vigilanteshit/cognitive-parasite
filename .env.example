# Copy to .env; never commit real values. Demo requires no credentials.
PARASITE_DATA_DIR=.local/data
PARASITE_MODELS_FILE=models.toml
PARASITE_MEMORY_BACKEND=sqlite
# PARASITE_OPENAI_API_KEY=
# PARASITE_ANTHROPIC_API_KEY=
# PARASITE_AZURE_API_KEY=
# PARASITE_AZURE_ENDPOINT=https://your-resource.openai.azure.com
# PARASITE_AZURE_API_VERSION=2024-10-21
# Embeddings are independent of the chat model. Changing them requires reindexing.
PARASITE_EMBEDDING_PROVIDER=demo
PARASITE_EMBEDDING_MODEL=hash-v1
PARASITE_EMBEDDING_DIMENSIONS=64
# PARASITE_NEO4J_URI=bolt://localhost:7687
# PARASITE_NEO4J_USER=neo4j
# PARASITE_NEO4J_PASSWORD=
# PARASITE_NEO4J_DATABASE=neo4j
PARASITE_MAX_STEPS=16
PARASITE_MAX_RUN_TOKENS=120000
PARASITE_MAX_RUN_SECONDS=120
